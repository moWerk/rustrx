[Desktop Entry]
Type=Application
X-Nemo-Application-Type=silica-qt5
Icon=harbour-rustrx
Exec=harbour-rustrx
Name=Rustrx
Comment=A Matrix client
# one instance: a second launch raises the running window
X-Nemo-Single-Instance=yes
# matrix: links (matrix:r/room:server, matrix:u/person:server) come over D-Bus,
# so the sandbox's check of the command line does not refuse them
MimeType=x-scheme-handler/matrix;
X-Maemo-Service=net.mowerk.harbour-rustrx
X-Maemo-Object-Path=/net/mowerk/harbour_rustrx
X-Maemo-Method=net.mowerk.harbour_rustrx.openUrl
# a target in the share sheet: org.sailfishos.share on /share
X-Share-Methods=room;

[X-Sailjail]
# Internet for the homeserver; Pictures, Videos, Music, Documents and Downloads for sending
# files from the pickers; MediaIndexing for the gallery picker (it reads the
# Tracker index); Camera for the photos taken in the app (a sandboxed app
# cannot start the stock camera); Audio to play voice messages and videos;
# Microphone to record voice messages.
OrganizationName=net.mowerk
ApplicationName=harbour-rustrx
Permissions=Internet;Pictures;Videos;Music;Documents;Downloads;MediaIndexing;Camera;Audio;Microphone;AppLaunch

[X-Share Method room]
Description=Send to a room
Capabilities=text/x-url;text/plain;image/*;video/*;audio/*;application/*;
SupportsMultipleFiles=true
