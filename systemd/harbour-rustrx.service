# Rustrx in the background: started with the session when the user switched
# "Keep running in the background" on (the app then writes the flag file in
# its own sandboxed config folder; without it this unit does nothing).
# Started through invoker exactly like the launcher and the D-Bus service do,
# so the process runs in the same sandbox and finds its session and store.
[Unit]
Description=Rustrx Matrix client (background)
ConditionPathExists=%h/.config/net.mowerk/harbour-rustrx/background

[Service]
Environment=RUSTRX_BACKGROUND=1
ExecStart=/usr/bin/invoker --type=silica-qt5 --single-instance --id=harbour-rustrx harbour-rustrx
Restart=no

[Install]
WantedBy=post-user-session.target
